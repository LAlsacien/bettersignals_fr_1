function data()
    -- =========================================================================
    -- UTILITAIRES DE CONFIGURATION
    -- =========================================================================
    local function intRange(start, stop, step)
        local a = {}
        local i = start
        while i <= stop do
            table.insert(a, i)
            i = i + step
        end
        return a
    end

    local function map(a, f)
        local res = {}
        if a and type(a) == "table" then
            for _, v in ipairs(a) do
                table.insert(res, f(v))
            end
        end
        return res
    end

    local range_offset = map(intRange(-10, 10, 1), tostring)
    local range_rot = map(intRange(-180, 180, 5), tostring)

    return {
        type = "ASSET_TRACK",
        description = {
            name = _("Type A - LED"),
            description = _("Signalisation ferroviaire SNCF moderne de type A"),
            icon = "ui/construction/assets/a_type_bal.tga"
        },
        availability = { yearFrom = 2005 },
        skipOnInit = true,
        categories = { "better_signals" },
        skipCollision = true,
        autoRemovable = false,
        order = 11111,
        params = {
            {
                key = "opt_vcli",
                name = _("Activer la pré-annonce (Vert Clignotant)"),
                uiType = "CHECKBOX",
                defaultIndex = 0,
            },
            {
                key = "opt_pos",
                name = _("Position du signal"),
                uiType = "COMBOBOX",
                values = { _("Gauche"), _("Droite") },
                defaultIndex = 0,
            },
            {
                key = "opt_cible_spec",
                name = _("Type de Cible Spécifique"),
                uiType = "COMBOBOX",
                values = { _("Standard"), _("Sans Avertissement (BM/BAPR)") },
                defaultIndex = 0,
            },
            {
                key = "mast_type",
                name = _("Type de Mât"),
                uiType = "COMBOBOX",
                values = { _("Simple"), _("Léger"), _("Lourd"), _("Nacelle") },
                defaultIndex = 0,
            },
            {
                key = "mast_style",
                name = _("Style / Époque"),
                uiType = "COMBOBOX",
                values = { _("Moderne"), _("Ancien"), _("Ancien Rayé") },
                defaultIndex = 0,
            },
            {
                key = "mast_flag",
                name = _("Mât Drapeau"),
                uiType = "CHECKBOX",
                defaultIndex = 0,
            },
            {
                key = "mast_tall",
                name = _("Mât Haut"),
                uiType = "CHECKBOX",
                defaultIndex = 0,
            },
            {
                key = "mast_black",
                name = _("Version Noire"),
                uiType = "CHECKBOX",
                defaultIndex = 0,
            },
            {
                key = "opt_plaque_id",
                name = _("Plaque d'Identification"),
                uiType = "COMBOBOX",
                values = { _("Standard"), _("BM (Block Manuel)"), _("PR (Point de Repère)") },
                defaultIndex = 0,
            },
            {
                key = "add_fleche",
                name = _("Ajouter une Flèche"),
                uiType = "COMBOBOX",
                values = { _("Aucune"), _("Flèche Simple"), _("Flèche Double"), _("Flèche Triple"), _("Flèche Droite") },
                defaultIndex = 0,
            },
            {
                key = "offset_x",
                name = _("Décalage X (Avant/Arrière)"),
                uiType = "SLIDER",
                values = range_offset,
                defaultIndex = 10,
            },
            {
                key = "offset_y",
                name = _("Décalage Y (Gauche/Droite)"),
                uiType = "SLIDER",
                values = range_offset,
                defaultIndex = 10,
            },
            {
                key = "offset_z",
                name = _("Décalage Z (Haut/Bas)"),
                uiType = "SLIDER",
                values = range_offset,
                defaultIndex = 10,
            },
            {
                key = "offset_rot",
                name = _("Rotation Z (Degrés)"),
                uiType = "SLIDER",
                values = range_rot,
                defaultIndex = 36,
            }
        },
        updateFn = function(params)
            local result = {
                models = {},
                groundFaces = {},
                terrainAlignmentLists = {}
            }
            
            -- =========================================================================
            -- 1. INITIALISATION DES VARIABLES
            -- =========================================================================
            local has_jcli = (params.opt_jcli == 1)
            local has_vcli = (params.opt_vcli == 1)
            local is_droite = (params.opt_pos == 1)
            local opt_spec = params.opt_cible_spec or 0
            
            local mast_type = params.mast_type or 0
            local mast_style = params.mast_style or 0
            local mast_flag = (params.mast_flag == 1)
            local mast_tall = (params.mast_tall == 1)
            local mast_black = (params.mast_black == 1)
            
            -- =========================================================================
            -- RÈGLES LOGIQUES (OVERRIDES)
            -- =========================================================================
            if mast_style == 1 or mast_style == 2 then
                if mast_type == 3 then
                    mast_style = 1 -- Nacelle ancienne is always style 1 (never rayé)
                else
                    mast_type = 2 -- Force Lourd for ancient masts
                end
            end
            
            if mast_style == 0 then
                mast_black = false -- Modern masts are never black
            end
            
            local opt_plaque = params.opt_plaque_id or 0
            local fleche_type = params.add_fleche or 0

            -- Décalages utilisateurs
            local ox = (params.offset_x or 10) - 10
            local oy = (params.offset_y or 10) - 10
            local oz = (params.offset_z or 10) - 10
            local orot = ((params.offset_rot or 36) * 5) - 180

            -- =========================================================================
            -- 2. MOTEUR LOGIQUE (RADAR / LOOK-AHEAD)
            -- =========================================================================

            local force_rcli = 0

            if params.paramsOverride and params.paramsOverride.rcli then
                force_rcli = 1
            elseif params.following_signal then
                if params.following_signal.paramsOverride and params.following_signal.paramsOverride.rcli then
                    force_rcli = 2
                elseif params.following_signal.following_signal and params.following_signal.following_signal.paramsOverride and params.following_signal.following_signal.paramsOverride.rcli then
                    force_rcli = 3
                elseif params.following_signal.following_signal and params.following_signal.following_signal.following_signal and params.following_signal.following_signal.following_signal.paramsOverride and params.following_signal.following_signal.following_signal.paramsOverride.rcli then
                    force_rcli = 4
                end
            end

            local canton_court = (params.following_signal and params.following_signal.paramsOverride and tonumber(params.following_signal.paramsOverride.cc) == 1)
            local next_is_canton_court = (params.following_signal and params.following_signal.following_signal and params.following_signal.following_signal.paramsOverride and tonumber(params.following_signal.following_signal.paramsOverride.cc) == 1)
            local next_next_is_rr = 0
            if params.following_signal then
                if params.following_signal.following_signal and params.following_signal.following_signal.paramsOverride then
                    next_next_is_rr = tonumber(params.following_signal.following_signal.paramsOverride.rr) or 0

                elseif params.following_signal.following_signal and params.following_signal.following_signal.signal_speed then
                    local speed_current = params.signal_speed or 999
                    local speed_next = params.following_signal.following_signal.signal_speed
                    if speed_current > speed_next then
                        if speed_next > 0 and speed_next <= 30 then 
                            next_next_is_rr = 1
                        elseif speed_next > 30 and speed_next <= 60 then 
                            next_next_is_rr = 2
                        end
                    end
                end
            end

            local isGreen = (params.signal_state and params.signal_state == 1)
            local dist_red = 99
            if not isGreen then dist_red = 0
            elseif params.following_signal then
                if params.following_signal.signal_state == 0 then dist_red = 1
                elseif params.following_signal.following_signal then
                    if params.following_signal.following_signal.signal_state == 0 then dist_red = 2
                    elseif params.following_signal.following_signal.following_signal then
                        if params.following_signal.following_signal.following_signal.signal_state == 0 then dist_red = 3
                        elseif params.following_signal.following_signal.following_signal.following_signal then
                            if params.following_signal.following_signal.following_signal.following_signal.signal_state == 0 then dist_red = 4 end
                        end
                    end
                end
            end

            local display = "VERT"
            
            if dist_red == 0 then 
                display = "ROUGE"
                
            elseif dist_red == 1 then 
                if force_rcli == 1 then
                        display = "ROUGE_CLI"
                    else
                        display = "JAUNE"
                    end
                
            elseif dist_red == 2 then
                if force_rcli == 2 then
                    display = "JAUNE"
                elseif canton_court then
                    display = "JAUNE_CLI"
                elseif has_vcli then
                    display = "VERT_CLI"
                else 
                    display = "VERT"
                end
                
            elseif dist_red == 3 then
                if force_rcli == 3 then
                    if canton_court then
                        display = "JAUNE_CLI"
                    elseif has_vcli then
                        display = "VERT_CLI"
                    else
                        display = "VERT"
                    end
                else
                    if canton_court and next_next_is_rr == 1 then
                        display = "JAUNE_CLI"
                    elseif has_vcli and (next_is_canton_court or (next_next_is_rr > 0 and next_next_is_rr < 3)) then
                        display = "VERT_CLI"
                    else
                        display = "VERT"
                    end
                end
                
            elseif dist_red >= 4 then
                if force_rcli == 4 then
                    if has_vcli and next_is_canton_court then
                        display = "VERT_CLI"
                    else
                        display = "VERT"
                    end
                else             
                    if canton_court and next_next_is_rr == 1 then
                        display = "JAUNE_CLI"                
                    elseif has_vcli and (next_is_canton_court or (next_next_is_rr > 0 and next_next_is_rr < 3)) then
                        display = "VERT_CLI"
                    else
                        display = "VERT"
                    end
                end
            end

            -- =========================================================================
            -- 3. MOTEUR GÉOMÉTRIQUE (MATRICES) & STRING BUILDER
            -- =========================================================================
            
            local is_nacelle = (mast_type == 3)
            
            -- String Builder for the Mât
            local base_prefix = "Z_Base_M_"
            local type_str = ""
            if mast_type == 0 then type_str = "simple"
            elseif mast_type == 1 then type_str = "leger"
            elseif mast_type == 2 then type_str = "lourd"
            elseif mast_type == 3 then type_str = "nacelle" end
            
            local haut_str = (mast_tall and not is_nacelle) and "_haut" or ""
            local dra_str = (mast_flag and not is_nacelle and mast_type ~= 0) and "_dra" or ""
            
            local style_str = ""
            if mast_style == 1 then
                if is_nacelle then style_str = mast_black and "_ancienneN" or "_ancienneG"
                else style_str = mast_black and "_AN" or "_AG" end
            elseif mast_style == 2 then
                if not is_nacelle then style_str = mast_black and "_ARN" or "_ARG" end
            end
            
            if mast_style == 0 and is_nacelle then
                style_str = "_moderne"
            end
            
            local final_mast_mdl = base_prefix .. type_str .. haut_str .. dra_str .. style_str .. ".mdl"

            -- Geometric Offsets
            local base_z = 1.05
            local lx = 0
            local ly = 0
            local lz = base_z
            local px = 0
            local py = 0
            local pz = 0
            
            if is_nacelle then
                lx = -0.15
                ly = -1.35
                lz = base_z + 3.205
                
                -- Correction pour la nacelle ancienne : le modèle de plaque a un offset natif de x=0.21, y=-0.05
                -- alors que l'ancienne nacelle exige 0,0,0. On applique donc l'inverse.
                if mast_style == 1 then
                    px = -0.21
                    py = 0.05
                end
            else
                if mast_tall then lz = base_z + 1.860; pz = 1.860 end
                if mast_type == 1 then
                    if mast_flag then py = 0.425 end
                elseif mast_type == 2 then
                    if mast_flag then py = 0.64 else py = 0.2 end
                end
            end

            -- Calcul du shift Y (Inversion de polarité Alsace-Moselle / Gauche-Droite)
            local local_shift_y = 0 
            
            if is_droite then
                if is_nacelle then
                    local_shift_y = -2.4 
                else
                    local_shift_y = -4.8 
                    final_mast_mdl = string.gsub(final_mast_mdl, "%.mdl", "_Droite.mdl")
                end
            end

            -- Préparation des sinus/cosinus pour la rotation utilisateur
            local rad = math.rad(orot)
            local c = math.cos(rad)
            local s = math.sin(rad)
            local base_z = 1.05

            -- 3a. Matrice du Mât
            local mast_local_y = is_droite and local_shift_y or 0
            local matrice_mat = {
                c,  s, 0, 0,
               -s,  c, 0, 0,
                0,  0, 1, 0,
                ox + (0 * c - mast_local_y * s), oy + (0 * s + mast_local_y * c), oz + base_z, 1
            }

            -- 3b. Matrice des Cibles/Feux (suit le sommet du mât)
            ly = ly + local_shift_y
            
            local matrice_feux = {
                c,  s, 0, 0,
               -s,  c, 0, 0,
                0,  0, 1, 0,
                ox + (lx * c - ly * s), oy + (lx * s + ly * c), oz + lz, 1
            }

            -- Correction spécifique pour Cible Sans Avertissement (Décalage du rouge)
            local offset_z_rouge = (opt_spec == 1) and -0.22 or 0.0
            local matrice_feux_rouge = {
                c,  s, 0, 0,
               -s,  c, 0, 0,
                0,  0, 1, 0,
                ox + (lx * c - ly * s), oy + (lx * s + ly * c), oz + lz + offset_z_rouge, 1
            }

            -- 3c. Matrice de la Plaque d'identification
            -- Sanctuarisation : Inversion de polarité pour le décalage Y des plaques sur mât drapeau
            if is_droite and not is_nacelle then
                py = -py
            end
            py = py + local_shift_y
            
            local matrice_plaque = {
                c,  s, 0, 0,
                -s,  c, 0, 0,
                0,  0, 1, 0,
                ox + (px * c - py * s), oy + (px * s + py * c), oz + base_z + pz, 1
            }

            -- =========================================================================
            -- 4. ASSEMBLAGE DES MODÈLES (ASSEMBLER)
            -- =========================================================================

            -- 4a. Mât, Cible et Plaque
            local cible_mdl = (opt_spec == 1) and "Z_Cible_Type_A_SA.mdl" or "Z_Cible_Type_A.mdl"
            local hide_jaune = (opt_spec == 1)

            if hide_jaune then
                if display == "JAUNE" or display == "JAUNE_CLI" then display = "VERT" end
            end

            local plaque_mdl = ""
            if is_nacelle then
                if opt_plaque == 1 then plaque_mdl = "Z_Plaque_Nacelle_Type_A_BM.mdl"
                elseif opt_plaque == 2 then plaque_mdl = "Z_Plaque_Nacelle_Type_A_PR.mdl"
                else plaque_mdl = "Z_Plaque_Nacelle_Type_A_BAL.mdl" end
            else
                if opt_plaque == 1 then plaque_mdl = "Z_Plaque_Type_A_BM.mdl"
                elseif opt_plaque == 2 then plaque_mdl = "Z_Plaque_Type_A_PR.mdl"
                else plaque_mdl = "Z_Plaque_Type_A_BAL.mdl" end
            end

            table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/" .. final_mast_mdl, transf = matrice_mat })
            table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/" .. cible_mdl, transf = matrice_feux })
            table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/" .. plaque_mdl, transf = matrice_plaque })

            -- 4b. Flèche de direction
            if fleche_type > 0 then
                local f_prefixes = { "", "SNCF_Fleche", "SNCF_Fleche2", "SNCF_Fleche3", "SNCF_FlecheV" }
                local f_prefix = f_prefixes[fleche_type + 1]
                local f_pos = is_droite and "_dg" or "_gd"
                
                local f_mast = nil
                if mast_type == 0 then
                    f_mast = mast_tall and "_sh" or "_s"
                elseif mast_type == 1 then
                    f_mast = mast_tall and "_lh" or "_l"
                elseif mast_type == 2 then
                    if mast_flag then
                        f_mast = mast_tall and "_lohD" or "_loD"
                    else
                        f_mast = mast_tall and "_loh" or "_lo"
                    end
                end
                
                if f_mast then
                    table.insert(result.models, { 
                        id = "SNCF_Asset_Model/" .. f_prefix .. f_pos .. f_mast .. ".mdl", 
                        transf = { c,s,0,0, -s,c,0,0, 0,0,1,0, ox,oy,oz, 1 } 
                    })
                end
            end

            -- 4c. Affichage des Feux (États)
            if display == "ROUGE" then
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Rouge_Allume.mdl", transf = matrice_feux_rouge })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Vert_Eteint.mdl", transf = matrice_feux })
                if not hide_jaune then table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Jaune_Eteint.mdl", transf = matrice_feux }) end
            
            elseif display == "JAUNE" then
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Jaune_Allume.mdl", transf = matrice_feux })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Rouge_Eteint.mdl", transf = matrice_feux_rouge })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Vert_Eteint.mdl", transf = matrice_feux })
            
            elseif display == "JAUNE_CLI" then
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Jaune_Cli_Allume.mdl", transf = matrice_feux })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Jaune_Eteint.mdl", transf = matrice_feux }) 
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Rouge_Eteint.mdl", transf = matrice_feux_rouge })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Vert_Eteint.mdl", transf = matrice_feux })
            
            elseif display == "ROUGE_CLI" then
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Rouge_Cli_Allume.mdl", transf = matrice_feux_rouge })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Rouge_Eteint.mdl", transf = matrice_feux_rouge })
                if not hide_jaune then table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Jaune_Eteint.mdl", transf = matrice_feux }) end
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Vert_Eteint.mdl", transf = matrice_feux })
            
            elseif display == "VERT" then
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Vert_Allume.mdl", transf = matrice_feux })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Rouge_Eteint.mdl", transf = matrice_feux_rouge })
                if not hide_jaune then table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Jaune_Eteint.mdl", transf = matrice_feux }) end
            
            elseif display == "VERT_CLI" then
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Vert_Cli_Allume.mdl", transf = matrice_feux })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Rouge_Eteint.mdl", transf = matrice_feux })
                table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Vert_Eteint.mdl", transf = matrice_feux })
                if not hide_jaune then table.insert(result.models, { id = "SNCF_Signaux_Moderne_Model/Z_L_Feu_Jaune_Eteint.mdl", transf = matrice_feux }) end
            end

            -- Interface au sol
            table.insert(result.groundFaces, {  
                face = { { -1, -1, 0 }, { 1, -1, 0 }, { 1, 1, 0 } },
                modes = { { type = "FILL", key = "industry_floor.lua" } },
                loop = true,
                alignmentOffsetMode = "OBJECT",
                alignmentDirMode = "OBJECT",
                alignmentOffset = { -2.0, -1.0 },
            })
            table.insert(result.terrainAlignmentLists, { type = "EQUAL", faces =  { } })
            
            return result
        end
    }
end